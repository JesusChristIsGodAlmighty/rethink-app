<?xml version="1.0" encoding="utf-8"?><!-- F224 Blocklist Manager: one row per curated blocklist -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/iblm_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true" />

    <LinearLayout
        android:id="@+id/iblm_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iblm_move_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/f224_bm_move_up"
            android:padding="6dp"
            android:rotation="180"
            android:src="@drawable/ic_arrow_down_small" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iblm_move_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/f224_bm_move_down"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_down_small" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iblm_remove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/f224_bm_remove"
            android:padding="6dp"
            android:src="@drawable/ic_delete_small" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@id/iblm_actions"
        android:layout_toEndOf="@id/iblm_switch"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/iblm_title"
            style="@style/TextAppearance.Material3.BodyLarge.Emphasized"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/iblm_subtitle"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</RelativeLayout>
